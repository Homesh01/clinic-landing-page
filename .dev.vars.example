# Local secrets for `npm run dev` / Wrangler.
# Copy this file to `.dev.vars` (and keep `.dev.vars.example` in sync if you maintain one).
# Never commit `.dev.vars`.

# Site password gate (skipped automatically on localhost)
SITE_PASSWORD=preview
SITE_COOKIE_SECRET=replace-with-long-random-string

# Google Workspace booking + staff magic-link email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
BOOKING_TIMEZONE=Europe/London
BOOKING_FROM_EMAIL=
BOOKING_FROM_NAME=Personalised Cancer Care
BOOKING_BCC_EMAIL=

# Staff allowlist (comma-separated) + dedicated cookie secret (preferred over SITE_PASSWORD)
CLINIC_STAFF_EMAILS=you@example.com
CLINIC_STAFF_COOKIE_SECRET=replace-with-long-random-string

# Stripe (self-pay + staff refunds)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio outbound SMS (clinic patient contacts)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+447xxxxxxxxx

# D1 is bound via wrangler.json (binding DB) — no secret needed here.

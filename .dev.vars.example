# Shared site password for local development.
# Leave blank or remove this line to disable protection locally.
SITE_PASSWORD=preview

# Google Calendar booking (OAuth refresh-token flow)
# Enable APIs: Google Calendar API + Gmail API
# OAuth scopes needed on the refresh token:
#   https://www.googleapis.com/auth/calendar
#   https://www.googleapis.com/auth/gmail.send
# Confirmation emails are sent from the authorised Workspace account
# (not as a Google Calendar invite).
GOOGLE_CLIENT_ID=........apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=........
GOOGLE_REFRESH_TOKEN=........
GOOGLE_CALENDAR_ID=........@group.calendar.google.com
BOOKING_TIMEZONE=Europe/London

# Must be a verified "Send mail as" alias on the OAuth Workspace user.
# If this alias is missing, Gmail may show Homesh's address instead, or external
# mail can land in spam / not arrive.
BOOKING_FROM_EMAIL=bookings@personalisedcancercare.com
BOOKING_FROM_NAME=Dr Karen Sayal bookings

# Optional: BCC a copy of every patient confirmation (useful while testing)
# BOOKING_BCC_EMAIL=homesh.sayal@personalisedcancercare.com
